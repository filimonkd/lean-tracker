// Lean Tracker (calories & macros) — Prisma schema (PostgreSQL / Supabase)
//
// Date convention: every `date` column stores a *calendar day* as UTC midnight
// (e.g. 2026-10-29T00:00:00.000Z). The client sends its local "YYYY-MM-DD" and
// the server converts it, so "today" never drifts across time zones.

generator client {
  provider = "prisma-client-js"
}

// Supabase gives two connection strings:
// - DATABASE_URL: the pooled "transaction" connection (port 6543) the app uses
//   at runtime, so serverless functions don't exhaust Postgres connections.
// - DIRECT_URL: the direct connection (port 5432) that migrations need.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY // little or no exercise          × 1.2
  LIGHT // 1–3 days/week                       × 1.375
  MODERATE // 3–5 days/week                    × 1.55
  ACTIVE // 6–7 days/week                      × 1.725
  VERY_ACTIVE // hard training / physical job  × 1.9
}

model User {
  id   String  @id @default(cuid())
  name String?

  // Daily targets (what the dashboard compares against)
  dailyCalorieGoal Int   @default(2000)
  dailyProteinGoal Int   @default(150) // grams
  dailyCarbGoal    Int   @default(200) // grams
  dailyFatGoal     Int   @default(67) // grams

  // Onboarding profile — stored in metric; the UI can convert for display
  currentWeightKg Float?
  goalWeightKg    Float?
  heightCm        Float?
  age             Int?
  gender          Gender?
  activityLevel   ActivityLevel?
  onboardedAt     DateTime?

  // IANA zone (e.g. "Africa/Addis_Ababa"), captured from the browser at
  // onboarding so the server knows which calendar day "today" is.
  timezone String @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foodLogs    FoodLog[]
  weightLogs  WeightLog[]
  customFoods FoodItem[]
}

model FoodItem {
  id          String  @id @default(cuid())
  name        String
  servingSize String  @default("1 serving") // human label, e.g. "1 cup (158 g)"
  calories    Float // per serving
  protein     Float // grams per serving
  carbs       Float // grams per serving
  fat         Float // grams per serving
  isCustom    Boolean @default(false)

  // Custom foods belong to the user who created them; seeded foods are global.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Logs read nutrition from their FoodItem, so a food that has been logged is
  // never changed or removed: editing makes a new version and deleting hides
  // it. Archived foods disappear from search but past entries keep their values.
  archivedAt DateTime?

  createdAt DateTime  @default(now())
  logs      FoodLog[]

  @@index([name])
  @@index([createdById, archivedAt])
}

model FoodLog {
  id       String   @id @default(cuid())
  date     DateTime // calendar day at UTC midnight
  mealType MealType
  quantity Float    @default(1) // number of servings

  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WeightLog {
  id     String   @id @default(cuid())
  date   DateTime // calendar day at UTC midnight
  weight Float // kg

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One weigh-in per day — logging again the same day updates it.
  @@unique([userId, date])
}
